Require bash

Set Shell bash
Set FontSize 16
Set Width 1400
Set Height 900
Set Padding 20
Set Margin 10
Set MarginFill "#1a1b26"
Set BorderRadius 8
Set Theme "Catppuccin Mocha"
Set TypingSpeed 50ms
Set PlaybackSpeed 2.0
Set Framerate 30

Hide
